# Local PostgreSQL (docker compose up -d db). Never commit .env.
DATABASE_URL=postgresql://petcare:petcare_local@localhost:5432/petcare
DATABASE_POOL_MAX=10
# Optional PEM root CA for hosted PostgreSQL; accepts real newlines or literal \n.
# Supabase: download CA from Database Settings > SSL configuration.
DATABASE_SSL_CA=
APP_URL=http://localhost:3000
# demo works only outside production. Production: supabase, disabled or proxy.
AUTH_MODE=demo
AUTH_PROXY_SECRET=
# Proxy must strip incoming identity headers, authenticate, then inject these headers.
AUTH_SIGN_IN_URL=
AUTH_SIGN_OUT_URL=
# Explicit seed command only; requests never seed or migrate.
PETCARE_SEED_DEMO=true
# Google OAuth via Supabase (server-side only; no service_role key)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set AUTH_MODE=supabase only after configuring the Google provider and redirects.
# Set only after the owner confirms identity and receiving bank details.
PETCARE_OWNER_EMAIL=
PAYMENT_PARTNER_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
